# Suraxa Cloud MQTT Broker Configuration
# WebSocket Secure (WSS) broker URL
EXPO_PUBLIC_MQTT_BROKER_URL=wss://broker.example.com:8883/mqtt

# MQTT Client Credentials (leave blank if anonymous or token-based)
EXPO_PUBLIC_MQTT_USERNAME=
EXPO_PUBLIC_MQTT_PASSWORD=

# App Client ID Prefix
EXPO_PUBLIC_MQTT_CLIENT_PREFIX=suraxa_app_
